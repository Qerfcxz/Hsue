cabal-version:      3.0
name:               Hsue
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             Qerfcxz
build-type:         Simple
extra-doc-files:    CHANGELOG.md

flag has-call-stack
    default:     False
    manual:      True

common warnings
    ghc-options: -Wall

library
    import:           warnings
    if flag(has-call-stack)
        cpp-options: -DHAS_CALL_STACK
    exposed-modules:
        Engine.Animation
        Engine.Atlas
        Engine.Collector
        Engine.Container
        Engine.Coroutine
        Engine.Engine
        Engine.Event
        Engine.Helper
        Engine.Operation
        Engine.Projection
        Engine.Render
        Engine.Request
        Engine.Selector
        Engine.Shader
        Engine.Text
        Engine.Type
        Engine.Underlying
        Engine.Widget
        Engine.Window
        MSDF.Function
        MSDF.Type
        SDL.Function
        SDL.Include
        SDL.Type
        Error.Function
        Error.Type
    build-depends:
        base ^>=4.20.2.0,
        bytestring ==0.12.2.0,
        containers ==0.8,
        hashable ==1.5.1.0,
        text ==2.1.4,
        transformers ==0.6.3.0,
        unordered-containers ==0.2.21,
        vector ==0.13.2.0
    extra-libraries:
        msdf
        msdf-atlas-gen
        msdfgen-ext
        msdfgen-core
        SDL3
        SDL3_image
    include-dirs:
        C:\D\MSYS2\mingw64\include\SDL3
        C:\D\MSYS2\mingw64\include\SDL3_image
    extra-lib-dirs:
        C:\D\MSYS2\mingw64\lib
        C:\D\msdf-atlas-gen-master\build
        C:\D\msdf-atlas-gen-master\build\msdfgen
    hs-source-dirs:   src
    default-language: Haskell2010