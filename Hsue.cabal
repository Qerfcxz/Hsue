cabal-version:      3.0
name:               Hsue
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Qerfcxz
-- maintainer:
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Engine.Engine
        Engine.Error
        Engine.Event
        Engine.Other
        Engine.Request
        Engine.Type
        Engine.Widget
        Engine.Window
        SDL.Constant
        SDL.Function
        SDL.Type
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.18.3.0,
        bytestring ==0.12.2.0,
        containers ==0.8,
        text ==2.1.2
    hs-source-dirs:   src
    default-language: Haskell2010

executable Hsue
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.18.3.0,
        bytestring ==0.12.2.0,
        containers ==0.8,
        text ==2.1.2,
        Hsue

    hs-source-dirs:   app
    default-language: Haskell2010
